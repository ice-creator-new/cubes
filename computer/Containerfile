# Cubes 沙盒：一台小 Linux 桌面（浏览器、文件管理、终端），机器人通过 cubes_computer.py 操作它。
# 由 computer/sandbox.py 构建和启动；镜像源可用 --build-arg 换成别的。
ARG BASE=docker.m.daocloud.io/library/debian:trixie-slim
FROM ${BASE}

ARG APT_MIRROR=mirrors.ustc.edu.cn
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    DISPLAY=:1 \
    PIP_INDEX_URL=${PIP_INDEX} \
    ANONYMIZED_TELEMETRY=false \
    BROWSER_USE_SETUP_LOGGING=false

# Beyond the desktop: the everyday command-line tools a bot reaches for in the terminal.
RUN sed -i "s#deb.debian.org#${APT_MIRROR}#g" /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      xvfb x11vnc novnc websockify \
      xfce4-session xfwm4 xfce4-panel xfdesktop4 xfce4-terminal thunar mousepad \
      dbus-x11 adwaita-icon-theme \
      chromium fonts-noto-cjk \
      xdotool xclip sudo \
      python3 python3-venv python3-pip \
      ca-certificates curl wget git jq unzip zip less file procps \
 && rm -rf /var/lib/apt/lists/*

# Every Chromium start on the screen (the panel icon, xdg-open, the agent) lands in one profile
# with one debugging port, so Playwright drives the very window the user sees. The container is
# already the sandbox (its own VM); Chromium's inner sandbox needs user namespaces it lacks here.
RUN printf '%s\n' 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-dev-shm-usage --no-first-run --test-type --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --user-data-dir=/home/cubes/.config/chromium"' \
      > /etc/chromium.d/cubes-sandbox \
 && printf '%s\n' '#!/bin/sh' 'exec chromium "$@" >/tmp/chromium.log 2>&1' > /usr/local/bin/cubes-browser \
 && chmod 0755 /usr/local/bin/cubes-browser

COPY requirements.txt /opt/agent/requirements.txt
RUN python3 -m venv /opt/agent \
 && /opt/agent/bin/pip install --no-cache-dir -r /opt/agent/requirements.txt \
 && /opt/agent/bin/python -c "import mss, websockets, PIL, browser_use"

# The VM is thrown away after every run, so the bots may install what a task needs.
# Default apps set up front: otherwise the first click on the panel's browser icon opens a
# chooser dialog, and a weak model spends steps on it.
RUN useradd --create-home --shell /bin/bash cubes \
 && printf 'cubes ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/cubes \
 && chmod 0440 /etc/sudoers.d/cubes \
 && mkdir -p /home/cubes/Desktop /home/cubes/.config/xfce4/xfconf/xfce-perchannel-xml \
 && cp /etc/xdg/xfce4/panel/default.xml /home/cubes/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml \
 && printf 'WebBrowser=chromium\nFileManager=thunar\nTerminalEmulator=xfce4-terminal\n' > /home/cubes/.config/xfce4/helpers.rc \
 && chown -R cubes:cubes /home/cubes

COPY cubes_computer.py /opt/agent/cubes_computer.py
COPY sandbox-entry.sh /usr/local/bin/cubes-sandbox
RUN chmod 0755 /usr/local/bin/cubes-sandbox

USER cubes
WORKDIR /home/cubes
EXPOSE 6080
ENTRYPOINT ["/usr/local/bin/cubes-sandbox"]
