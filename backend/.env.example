# Cubes supervisor backend configuration.
# Copy to backend/.env and fill in MODEL_NAME and MODEL_API_KEY.
# Real environment variables override the values in this file.
#
# The MODEL_* values below are imported once, on the first start of a fresh database,
# as a provider named "mify" (protocol openai-chat). After that every model setting lives
# in the database (「设置 → 模型服务」), and editing these three lines has no effect:
# deleting the mify provider never imports it again.

# Model service base URL (OpenAI-compatible); /chat/completions is appended.
MODEL_BASE_URL=http://model.mify.ai.srv/v1

# Model service API key. Never sent to any client; only backend/.env may hold it.
MODEL_API_KEY=

# Model name to request. Leave empty until you know the exact name your service exposes.
MODEL_NAME=

# SQLite file. Relative paths resolve against the backend/ directory.
DATABASE_PATH=data/cubes.sqlite3

# Per-chunk read timeout for streamed completions, in seconds.
REQUEST_TIMEOUT=120

# How long POST /runs/{id}/stop waits for a graceful stop before cancelling the task.
STOP_TIMEOUT=15

# How long a destructive tool (delete_agent, dissolve_group) waits for the user to
# confirm before it fails with an explicit timeout message. Stopping the run counts as
# refusing.
CONFIRM_TIMEOUT_SECONDS=600

# Context budget, in tokens, for a model whose provider entry in the database does not
# declare its own window (a provider's model_limits can override both). A request may use
# CONTEXT_WINDOW_DEFAULT - min(output, 20000) - 8000 tokens; once it would pass 90% of that,
# the older part of the conversation is folded into a rolling summary instead of failing.
CONTEXT_WINDOW_DEFAULT=128000
CONTEXT_OUTPUT_DEFAULT=8192

# Budgets. Reaching one ends the run as "limited" and keeps everything already produced; it
# never limits how many members or groups the team may have over time. Each bot's turn (one
# reply plus the tools it calls on the way) has its own share, so in a group relay a later
# member is not starved by the earlier ones; the run as a whole has a larger cap.
MAX_MODEL_CALLS_PER_TURN=16
MAX_TOOL_CALLS_PER_TURN=32
MAX_MODEL_CALLS_PER_RUN=64
MAX_TOOL_CALLS_PER_RUN=128
# A workflow walks up to 30 steps inside one run, each its own bounded turn, so its run-level
# cap is wider than a chat's. The per-turn caps above still apply to every single step.
MAX_WORKFLOW_MODEL_CALLS_PER_RUN=160
MAX_WORKFLOW_TOOL_CALLS_PER_RUN=256
# Computer steps per run; they do not count against the tool-call budgets, and each one
# allows one more model call to read its screenshot.
MAX_COMPUTER_STEPS_PER_RUN=60
MAX_NEW_AGENTS_PER_RUN=8
MAX_NEW_GROUPS_PER_RUN=4

# Timezone of scheduled tasks. A rule written as 09:00 means 09:00 here, across restarts
# and daylight saving. Invalid names stop the backend at startup with a clear message.
TIMEZONE=Asia/Shanghai

# How often (seconds) the backend checks for due scheduled tasks. A due task never waits
# longer than one tick; tasks queued behind a running reply start as soon as that reply
# ends, whatever this value is. Tests lower it.
SCHEDULE_TICK_SECONDS=30

# Memory extraction is batched per conversation: finished turns wait until the conversation
# has been quiet this many seconds, or until this many turns are waiting, then one model call
# reads them all. Acknowledgements (好的/谢谢) and turns that already used remember are skipped.
# MEMORY_IDLE_SECONDS=120
# MEMORY_BATCH_TURNS=5

# How long a bot waits after the user's last reaction to one of its messages before it takes
# one small look and decides to ignore, react back or say one line. Several reactions inside
# this window are answered with one call.
REACTION_DEBOUNCE_SECONDS=2

# Exact browser origins allowed to call this API (comma-separated). The defaults cover the
# web dev server (http://127.0.0.1:1420) and the desktop window (app://cubes). "*" is refused.
# CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,app://cubes

# The bots' working folder: where a relative path lands, and where run_code starts. Defaults
# to workspace/ beside the database (data/workspace). Relative paths resolve against the
# backend/ directory. Writing here, running code and reaching other places follow each bot's
# approval mode (设置 → 权限), which the user picks; this backend has no authentication, so a
# bot with 完全权限 can touch anything your user account can. Only run it on a machine you
# control.
# WORKSPACE_DIR=data/workspace

# Search chain, tried in order until one provider returns usable sources. Tavily and Brave
# only join when their key is present; Parallel, Exa and DuckDuckGo work without a key.
# Note: every query leaves this machine and goes to the chosen third-party provider.
SEARCH_PROVIDERS=parallel,exa,tavily,brave,duckduckgo

# Search API keys. Empty means that provider is skipped, never an error.
PARALLEL_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=

# Provider endpoints. Only change them to point at a proxy or a test server.
# PARALLEL_MCP_URL=https://search.parallel.ai/mcp
# PARALLEL_API_URL=https://api.parallel.ai/v1beta/search
# EXA_MCP_URL=https://mcp.exa.ai/mcp
# EXA_API_URL=https://api.exa.ai/search
# TAVILY_API_URL=https://api.tavily.com/search
# BRAVE_API_URL=https://api.search.brave.com/res/v1/web/search
# DUCKDUCKGO_URL=https://html.duckduckgo.com/html/
